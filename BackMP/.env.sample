# Server Configuration
PORT=3003
NODE_ENV=development
CORS_ORIGIN=*

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=backmp_db
DB_LOGGING=false

# JWT Configuration
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Socket.IO Configuration
SOCKET_CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_FORMAT=dev

# API Configuration
API_VERSION=v1
API_PREFIX=/api

# Mercado Pago Configuration
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
MP_SUCCESS_URL=http://localhost:3000/payment/success
MP_FAILURE_URL=http://localhost:3000/payment/failure
MP_PENDING_URL=http://localhost:3000/payment/pending
MP_NOTIFICATION_URL=http://localhost:3003/api/payment/webhook
MP_WEBHOOK_SECRET=your-webhook-secret

# Límites de Pagos
MP_MAX_AMOUNT=50000
MP_MAX_DAILY_REFUNDS=10
MP_ALLOWED_PAYMENT_METHODS=credit_card,debit_card
MP_INSTALLMENTS_LIMIT=12
MP_CURRENCY=ARS
MP_RISK_LEVEL=strict

# Redis (para colas y cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# Monitoreo
DATADOG_API_KEY=your-datadog-api-key
SENTRY_DSN=your-sentry-dsn
PROMETHEUS_PORT=9090

# Alertas
ALERT_EMAIL=security-team@company.com
SLACK_WEBHOOK_URL=your-slack-webhook-url
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# 2FA
2FA_ISSUER=BackMP
2FA_SECRET_LENGTH=32
2FA_WINDOW=1

# Cache
CACHE_TTL=3600
CACHE_MAX_ITEMS=1000

# Retry Configuration
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_MS=2000
EXPONENTIAL_BACKOFF=true

# Servicios Relacionados
BACKFUTBOL_URL=http://localhost:3001
BACKFUTBOL_API_KEY=your-backfutbol-api-key
BACKUPYUC_URL=http://localhost:3002
BACKUPYUC_API_KEY=your-backupyuc-api-key