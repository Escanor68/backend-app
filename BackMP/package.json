        "lint-staged": "^16.1.2",
        "mocha": "^11.7.1",
        "nodemon": "^3.1.10",
        "nyc": "^17.0.0",
        "prettier": "^3.6.2",
        "sinon": "^21.0.0",
        "supertest": "^7.1.1",
        "swagger-ui-express": "^5.0.1",
        "ts-jest": "^29.1.0",
        "ts-node": "^10.9.1",
        "typescript": "^5.0.4"
    }
}
