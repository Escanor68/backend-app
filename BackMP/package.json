{
    "name": "backmp",
    "version": "1.0.0",
    "description": "Backend para integración con MercadoPago",
    "main": "dist/index.js",
    "scripts": {
        "start": "node dist/index.js",
        "dev": "nodemon src/index.ts",
        "dev:dist": "ts-node src/localDist.ts",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "build": "tsc",
        "lint": "eslint . --ext .ts",
        "format": "prettier --write \"src/**/*.ts\"",
        "prepare": "husky install",
        "typeorm": "typeorm-ts-node-commonjs",
        "migration:generate": "npm run typeorm migration:generate",
        "migration:run": "npm run typeorm migration:run",
        "migration:revert": "npm run typeorm migration:revert"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Escanor68/backend-app.git"
    },
    "author": "Timoteo Grebosz",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/Escanor68/backend-app/issues"
    },
    "homepage": "https://github.com/Escanor68/backend-app#readme",
    "dependencies": {
        "bcrypt": "^6.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "dotenv": "^16.0.3",
        "express": "^4.18.2",
        "express-rate-limit": "^6.7.0",
        "express-validator": "^7.0.1",
        "helmet": "^7.0.0",
        "jsonwebtoken": "^9.0.0",
        "mercadopago": "^2.7.0",
        "pg": "^8.11.0",
        "socket.io": "^4.6.1",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^4.6.3",
        "typeorm": "^0.3.16",
        "winston": "^3.8.2",
        "winston-daily-rotate-file": "^4.7.1",
        "zod": "^3.25.30"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.3.0",
        "@commitlint/config-conventional": "^19.2.2",
        "@stryker-mutator/core": "^8.2.6",
        "@stryker-mutator/jest-runner": "^8.2.6",
        "@types/bcrypt": "^5.0.2",
        "@types/chai": "^4.3.16",
        "@types/compression": "^1.7.2",
        "@types/cors": "^2.8.13",
        "@types/express": "^4.17.17",
        "@types/helmet": "^4.0.0",
        "@types/jest": "^29.5.1",
        "@types/jsonwebtoken": "^9.0.2",
        "@types/mercadopago": "^1.5.11",
        "@types/node": "^20.2.3",
        "@types/nodemailer": "^6.4.15",
        "@types/socket.io": "^3.0.2",
        "@types/supertest": "^2.0.12",
        "@types/swagger-jsdoc": "^6.0.1",
        "@types/swagger-ui-express": "^4.1.3",
        "@types/validator": "^13.12.0",
        "@typescript-eslint/eslint-plugin": "^5.59.7",
        "@typescript-eslint/parser": "^5.59.7",
        "chai": "^5.1.1",
        "conventional-changelog-cli": "^5.0.0",
        "eslint": "^8.41.0",
        "husky": "^9.1.4",
        "jest": "^29.5.0",
        "jest-html-reporter": "^3.10.2",
        "lint-staged": "^15.2.7",
        "mocha": "^10.7.0",
        "nodemon": "^3.1.10",
        "nyc": "^17.0.0",
        "prettier": "^2.8.8",
        "sinon": "^18.0.0",
        "supertest": "^6.3.3",
        "ts-jest": "^29.1.0",
        "ts-node": "^10.9.1",
        "typescript": "^5.0.4"
    }
}
