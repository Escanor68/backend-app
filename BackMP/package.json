{
    "name": "backmp",
    "version": "1.0.0",
    "description": "Backend para integración con MercadoPago",
    "main": "dist/index.js",
    "scripts": {
        "start": "node dist/index.js",
        "dev": "nodemon src/index.ts",
        "dev:dist": "ts-node src/localDist.ts",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "build": "tsc",
        "lint": "eslint . --ext .ts",
        "format": "prettier --write \"src/**/*.ts\"",
        "prepare": "husky install",
        "typeorm": "typeorm-ts-node-commonjs",
        "migration:generate": "npm run typeorm migration:generate",
        "migration:run": "npm run typeorm migration:run",
        "migration:revert": "npm run typeorm migration:revert"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Escanor68/backend-app.git"
    },
    "author": "Timoteo Grebosz",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/Escanor68/backend-app/issues"
    },
    "homepage": "https://github.com/Escanor68/backend-app#readme",
    "dependencies": {
        "@types/node-cron": "^3.0.11",
        "@types/uuid": "^10.0.0",
        "axios": "^1.10.0",
        "bcrypt": "^6.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "dotenv": "^17.0.1",
        "express": "^5.1.0",
        "express-rate-limit": "^7.5.1",
        "express-validator": "^7.0.1",
        "fs-extra": "^11.3.0",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.0",
        "mercadopago": "^2.7.0",
        "mysql2": "^3.14.1",
        "node-cron": "^4.1.0",
        "nodemailer": "^7.0.3",
        "pdfkit": "^0.17.1",
        "pg": "^8.11.0",
        "socket.io": "^4.6.1",
        "swagger-jsdoc": "^6.2.8",
        "typeorm": "^0.3.24",
        "winston": "^3.8.2",
        "winston-daily-rotate-file": "^5.0.0",
        "zod": "^3.25.30"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.3.0",
        "@commitlint/config-conventional": "^19.2.2",
        "@stryker-mutator/core": "^9.0.1",
        "@stryker-mutator/jest-runner": "^9.0.1",
        "@types/bcrypt": "^5.0.2",
        "@types/chai": "^5.2.2",
        "@types/compression": "^1.7.2",
        "@types/cors": "^2.8.13",
        "@types/express": "^5.0.3",
        "@types/fs-extra": "^11.0.4",
        "@types/helmet": "^4.0.0",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.2",
        "@types/mercadopago": "^1.5.11",
        "@types/node": "^24.0.10",
        "@types/nodemailer": "^6.4.17",
        "@types/pdfkit": "^0.14.0",
        "@types/socket.io": "^3.0.2",
        "@types/supertest": "^6.0.3",
        "@types/swagger-jsdoc": "^6.0.1",
        "@types/swagger-ui-express": "^4.1.3",
        "@types/validator": "^13.12.0",
        "@typescript-eslint/eslint-plugin": "^8.35.1",
        "@typescript-eslint/parser": "^8.35.1",
        "chai": "^5.1.1",
        "conventional-changelog-cli": "^5.0.0",
