{
    "name": "backupyuc",
    "version": "1.0.0",
    "description": "Backend para gestión de UPyUC",
    "main": "index.js",
    "scripts": {
        "start": "node dist/index.js",
        "dev": "nodemon src/index.ts",
        "dev:dist": "ts-node src/localDist.ts",
        "test": "jest",
        "build": "tsc",
        "lint": "eslint . --ext .ts",
        "format": "prettier --write \"src/**/*.ts\"",
        "prepare": "husky install",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "typeorm": "typeorm-ts-node-commonjs",
        "migration:generate": "npm run typeorm migration:generate",
        "migration:run": "npm run typeorm migration:run",
        "migration:revert": "npm run typeorm migration:revert"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Escanor68/backend-app.git"
    },
    "author": "Timoteo Grebosz",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/Escanor68/backend-app/issues"
    },
    "homepage": "https://github.com/Escanor68/backend-app#readme",
    "dependencies": {
        "bcrypt": "^5.1.1",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "crypto": "^1.0.1",
        "dotenv": "^16.5.0",
        "express": "^4.21.2",
        "express-rate-limit": "^7.5.0",
        "express-validator": "^7.1.0",
        "helmet": "^7.2.0",
        "joi": "^17.13.3",
        "joi-objectid": "^4.0.2",
        "jsonwebtoken": "^9.0.2",
        "moment": "^2.30.1",
        "mysql-await": "^2.2.3",
        "nodemailer": "^6.10.1",
        "pg": "^8.16.0",
        "reflect-metadata": "^0.2.2",
        "rimraf": "^6.0.1",
        "run-script-os": "^1.1.6",
        "socket.io": "^4.8.1",
        "swagger-ui-express": "^5.0.1",
        "typeorm": "^0.3.24",
        "typeorm-transactional": "^0.5.0",
        "typeorm-transactional-cls-hooked": "^0.1.21",
        "uuid": "^10.0.0",
        "winston": "^3.17.0",
        "zod": "^3.25.30"
