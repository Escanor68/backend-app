        "@types/helmet": "^4.0.0",
        "@types/jest": "^29.5.14",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/node": "^22.15.23",
        "@types/nodemailer": "^6.4.17",
        "@types/supertest": "^6.0.3",
        "@types/uuid": "^10.0.0",
        "@types/validator": "^13.12.0",
        "@typescript-eslint/eslint-plugin": "^8.33.0",
        "@typescript-eslint/parser": "^8.33.0",
        "chai": "^5.1.1",
        "conventional-changelog-cli": "^5.0.0",
        "eslint": "^9.27.0",
